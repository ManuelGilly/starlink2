// Starlink Venezuela — Modelo de datos
// Todos los montos en USD (Decimal 12,2)

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

// =================== USUARIOS Y ROLES ===================

enum RoleName {
  ADMIN
  INVENTARIO
  CLIENTE
}

model User {
  id                String    @id @default(cuid())
  email             String    @unique
  name              String
  passwordHash      String
  mustChangePassword Boolean  @default(true)
  active            Boolean   @default(true)
  lastLoginAt       DateTime?
  telegramChatId    String?   @unique
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  roles          UserRole[]
  client         Client?
  auditLogs      AuditLog[]
  twoFactorCodes TwoFactorCode[]

  @@index([email])
}

model TwoFactorCode {
  id         String    @id @default(cuid())
  userId     String
  user       User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  codeHash   String
  expiresAt  DateTime
  consumedAt DateTime?
  createdAt  DateTime  @default(now())

  @@index([userId, expiresAt])
}

model Role {
  id          String    @id @default(cuid())
  name        RoleName  @unique
  description String?
  users       UserRole[]
}

model UserRole {
  userId String
  roleId String
  user   User @relation(fields: [userId], references: [id], onDelete: Cascade)
  role   Role @relation(fields: [roleId], references: [id], onDelete: Cascade)

  assignedAt DateTime @default(now())

  @@id([userId, roleId])
  @@index([roleId])
}

// =================== CLIENTES ===================

model Client {
  id          String   @id @default(cuid())
  userId      String?  @unique
  user        User?    @relation(fields: [userId], references: [id], onDelete: SetNull)

  firstName   String
  lastName    String
  email       String
  phone       String
  address     String?
  notes       String?
  telegramChatId String? @unique

  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  subscriptions  Subscription[]
  payments       Payment[]
  warranties     Warranty[]
  paymentReports PaymentReport[]
  sales          Sale[]
  equipment      Equipment[]
  tickets        SupportTicket[]
  clientNotes    ClientNote[]   @relation("clientNotes")

  @@index([email])
  @@index([phone])
}

// =================== PRODUCTOS E INVENTARIO ===================

model ProductCategory {
  id          String    @id @default(cuid())
  name        String    @unique
  description String?
  products    Product[]
  createdAt   DateTime  @default(now())
}

model Product {
  id            String   @id @default(cuid())
  sku           String   @unique
  name          String
  description   String?
  features      String?  // Características principales (texto libre / markdown)
  categoryId    String?
  category      ProductCategory? @relation(fields: [categoryId], references: [id], onDelete: SetNull)

  // Precios en USD
  costPrice     Decimal  @db.Decimal(12, 2) // costo unitario
  salePrice     Decimal  @db.Decimal(12, 2) // precio de venta

  // Inventario
  minStock      Int      @default(0)        // umbral mínimo para alertar
  warrantyDays  Int      @default(0)        // días de garantía por unidad vendida

  // Si true, se rastrea por unidad serializada (antenas/equipos); cada unidad
  // tiene su propio costo real (landed) según el lote en que se compró.
  // Si false, se maneja por cantidad y el costo es el del último lote.
  serialized    Boolean  @default(false)

  active        Boolean  @default(true)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  movements     InventoryMovement[]
  saleItems     SaleItem[]
  warranties    Warranty[]
  lots          PurchaseLot[]
  units         Equipment[]

  @@index([sku])
  @@index([categoryId])
}

enum MovementType {
  ENTRADA      // Compra / reposición
  SALIDA       // Venta
  AJUSTE       // Ajuste manual (+/-)
  MERMA        // Pérdida / daño
  DEVOLUCION   // Devolución de cliente
}

model InventoryMovement {
  id          String       @id @default(cuid())
  productId   String
  product     Product      @relation(fields: [productId], references: [id], onDelete: Cascade)

  type        MovementType
  quantity    Int          // signo según type: ENTRADA +, SALIDA -, etc. (se normaliza en lógica)
  unitCost    Decimal?     @db.Decimal(12, 2) // costo unitario al momento (solo ENTRADA)
  reference   String?      // # factura, remisión, nota
  notes       String?

  occurredAt  DateTime     @default(now())
  createdAt   DateTime     @default(now())

  lot         PurchaseLot? // lote de compra que generó esta ENTRADA (si aplica)

  @@index([productId, occurredAt])
  @@index([type])
}

// =================== COMPRAS / LOTES ===================
// Un lote = una compra de un producto con su costo base + flete + impuestos.
// El costo "landed" (real) se reparte entre las unidades del lote.

enum ChargeMode {
  FIXED       // monto fijo en USD
  PERCENT     // porcentaje sobre el costo base
}

model PurchaseLot {
  id              String     @id @default(cuid())
  productId       String
  product         Product    @relation(fields: [productId], references: [id], onDelete: Restrict)

  reference       String?    // # factura / remisión / orden de compra
  purchasedAt     DateTime   @default(now())
  quantity        Int        // unidades compradas en el lote

  // Costo base
  baseUnitCost    Decimal    @db.Decimal(12, 2)            // costo base por unidad (input)
  baseTotal       Decimal    @db.Decimal(12, 2)            // = baseUnitCost * quantity

  // Flete (opcional; fijo o %). El % se calcula sobre baseTotal.
  freightApplies  Boolean    @default(false)
  freightMode     ChargeMode?
  freightValue    Decimal?   @db.Decimal(12, 2)            // input crudo: USD si FIXED, % si PERCENT
  freightTotalUSD Decimal    @db.Decimal(12, 2) @default(0)

  // Impuestos (opcional; fijo o %). El % se calcula sobre baseTotal (solo base).
  taxApplies      Boolean    @default(false)
  taxMode         ChargeMode?
  taxValue        Decimal?   @db.Decimal(12, 2)
  taxTotalUSD     Decimal    @db.Decimal(12, 2) @default(0)

  // Resultado
  landedTotal     Decimal    @db.Decimal(12, 2)            // baseTotal + freightTotalUSD + taxTotalUSD
  landedUnitCost  Decimal    @db.Decimal(12, 2)            // landedTotal / quantity  ← costo real unitario

  notes           String?
  createdAt       DateTime   @default(now())
  createdBy       String?    // userId admin que registró el lote

  // INTEGRACIÓN
  movementId      String?    @unique
  movement        InventoryMovement? @relation(fields: [movementId], references: [id], onDelete: SetNull)
  units           Equipment[]        // unidades serializadas creadas por este lote

  @@index([productId, purchasedAt])
}

// =================== PLANES STARLINK ===================

enum BillingCycle {
  MONTHLY
  YEARLY
  ONE_TIME
}

model Plan {
  id            String   @id @default(cuid())
  code          String   @unique
  name          String
  description   String?
  details       String?  // Detalle extendido del plan (texto libre / markdown)
  price         Decimal  @db.Decimal(12, 2) // precio en USD
  cost          Decimal? @db.Decimal(12, 2) // costo estimado para margen
  billingCycle  BillingCycle @default(MONTHLY)
  active        Boolean  @default(true)

  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  subscriptions Subscription[]
  planRequests  PlanRequest[]
}

enum SubscriptionStatus {
  ACTIVA
  SUSPENDIDA
  CANCELADA
}

model Subscription {
  id          String   @id @default(cuid())
  clientId    String
  client      Client   @relation(fields: [clientId], references: [id], onDelete: Cascade)
  planId      String
  plan        Plan     @relation(fields: [planId], references: [id], onDelete: Restrict)

  status      SubscriptionStatus @default(ACTIVA)
  startDate   DateTime @default(now())
  endDate     DateTime?
  // Día del mes para el cobro recurrente (1-28)
  billingDay  Int      @default(1)
  // Precio pactado (puede diferir del plan.price si hubo descuento)
  priceLocked Decimal  @db.Decimal(12, 2)
  // Beneficio: el primer mes (mes de startDate) es gratis ($0), se marca al activar
  firstMonthFree Boolean @default(false)

  notes       String?
  origin      SaleOrigin  @default(ORGANICO)
  campaignId  String?
  campaign    AdCampaign? @relation(fields: [campaignId], references: [id], onDelete: SetNull)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  payments    Payment[]
  paymentReports PaymentReport[]

  @@index([clientId, status])
  @@index([planId])
  @@index([campaignId])
}

// =================== PAGOS ===================

enum PaymentStatus {
  PENDIENTE
  REPORTADO   // Cliente reportó, pendiente de verificación admin
  CONFIRMADO
  RECHAZADO
}

enum PaymentMethod {
  ZELLE
  PAYPAL
  BINANCE
  EFECTIVO_USD
  TRANSFERENCIA_USD
  PAGO_MOVIL
  OTRO
}

// Configuración por método de pago: emails, comisión PayPal, dirección efectivo, etc.
// Editable desde /metodos-pago en el admin.
model PaymentMethodConfig {
  id              String        @id @default(cuid())
  code            PaymentMethod @unique
  label           String
  accountEmail    String?
  accountInfo     String?
  commissionPct   Decimal?      @db.Decimal(5, 2)
  requiresReceipt Boolean       @default(true)
  showVesAmount   Boolean       @default(false)
  instructions    String?
  active          Boolean       @default(true)
  order           Int           @default(0)
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt
}

// Settings globales clave/valor (ej. tasa Bs/USD para pago móvil).
model AppSetting {
  key       String   @id
  value     String
  updatedAt DateTime @updatedAt
}

model Payment {
  id            String        @id @default(cuid())
  clientId      String
  client        Client        @relation(fields: [clientId], references: [id], onDelete: Cascade)
  subscriptionId String?
  subscription  Subscription? @relation(fields: [subscriptionId], references: [id], onDelete: SetNull)
  saleId        String?       @unique
  sale          Sale?         @relation(fields: [saleId], references: [id], onDelete: SetNull)

  // amount es el TOTAL canónico en USD = Σ splits.amountUSD (lo lee la app móvil).
  amount        Decimal       @db.Decimal(12, 2) // USD
  starlinkCost  Decimal?      @db.Decimal(12, 2) // Costo real pagado a Starlink (planes)
  // method = método del split principal/único (compatibilidad con métricas y móvil).
  method        PaymentMethod
  reference     String?       // # confirmación, hash, etc.
  status        PaymentStatus @default(PENDIENTE)
  periodStart   DateTime?     // Período que cubre (inicio)
  periodEnd     DateTime?     // Período que cubre (fin)
  paidAt        DateTime?
  confirmedAt   DateTime?
  confirmedBy   String?       // userId admin que confirmó
  notes         String?

  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt

  report        PaymentReport?
  splits        PaymentSplit[]

  @@index([clientId, status])
  @@index([subscriptionId])
  @@index([status])
}

// Desglose de un pago en uno o varios métodos. Permite que un pago se salde
// con varios métodos a la vez (ej. mitad Zelle, mitad Pago Móvil) y guarda el
// monto en Bs + la tasa del día (snapshot histórico) para métodos en bolívares.
model PaymentSplit {
  id          String        @id @default(cuid())
  paymentId   String
  payment     Payment       @relation(fields: [paymentId], references: [id], onDelete: Cascade)

  method      PaymentMethod
  amountUSD   Decimal       @db.Decimal(12, 2)   // canónico (USD)
  amountVes   Decimal?      @db.Decimal(14, 2)   // monto en Bs (si método en bolívares)
  vesRate     Decimal?      @db.Decimal(14, 4)   // tasa Bs/USD snapshot del pago
  reference   String?

  createdAt   DateTime      @default(now())

  @@index([paymentId])
  @@index([method])
}

// Reporte de pago enviado por el cliente (antes de confirmación admin)
model PaymentReport {
  id             String   @id @default(cuid())
  clientId       String
  client         Client   @relation(fields: [clientId], references: [id], onDelete: Cascade)
  subscriptionId String?
  subscription   Subscription? @relation(fields: [subscriptionId], references: [id], onDelete: SetNull)
  paymentId      String?  @unique
  payment        Payment? @relation(fields: [paymentId], references: [id], onDelete: SetNull)

  amount         Decimal  @db.Decimal(12, 2)
  method         PaymentMethod
  reference      String?
  reportedAt     DateTime @default(now())
  receiptUrl     String?  // Comprobante (futuro: subir archivo)
  notes          String?

  reviewed       Boolean  @default(false)
  reviewedAt     DateTime?
  reviewedBy     String?

  @@index([clientId])
  @@index([reviewed])
}

// =================== SOLICITUDES DE ACTIVACIÓN DE PLAN ===================
// Solicitud pública de un usuario que ya tiene antena Starlink y quiere contratar
// un plan. No requiere autenticación; el admin la revisa y activa manualmente.

enum PlanRequestStatus {
  PENDIENTE
  PROCESADA
  RECHAZADA
}

model PlanRequest {
  id             String   @id @default(cuid())

  firstName      String
  lastName       String
  email          String
  phone          String
  antennaId      String   // Kit / Service Line ID de la antena Starlink

  planId         String
  plan           Plan     @relation(fields: [planId], references: [id], onDelete: Restrict)
  amount         Decimal  @db.Decimal(12, 2) // USD, snapshot del precio al enviar

  paymentMethod  PaymentMethod
  paymentReference String?
  receiptUrl     String?  // null cuando el método no requiere comprobante (efectivo)
  notes          String?

  status         PlanRequestStatus @default(PENDIENTE)
  reviewedAt     DateTime?
  reviewedBy     String?   // userId admin que procesó
  reviewNotes    String?

  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@index([status, createdAt])
  @@index([email])
  @@index([antennaId])
  @@index([planId])
}

// =================== MARKETING ===================

enum SaleOrigin {
  ORGANICO
  INSTAGRAM_ADS
  RECOMENDADO
}

enum CampaignStatus {
  BORRADOR
  ACTIVA
  PAUSADA
  FINALIZADA
}

model AdCampaign {
  id               String         @id @default(cuid())
  name             String
  description      String?
  startDate        DateTime
  endDate          DateTime?
  budget           Decimal        @db.Decimal(12, 2) // inversión total USD
  messagesReceived Int            @default(0)
  status           CampaignStatus @default(ACTIVA)
  platform         String         @default("Instagram")
  adUrl            String?        // enlace al anuncio
  notes            String?
  createdAt        DateTime       @default(now())
  updatedAt        DateTime       @updatedAt

  sales         Sale[]
  subscriptions Subscription[]

  @@index([startDate, endDate])
  @@index([status])
}

// =================== VENTAS DE PRODUCTOS ===================

model Sale {
  id          String      @id @default(cuid())
  clientId    String
  client      Client      @relation(fields: [clientId], references: [id], onDelete: Cascade)

  total       Decimal     @db.Decimal(12, 2)
  paidAt      DateTime?
  notes       String?
  origin      SaleOrigin  @default(ORGANICO)
  campaignId  String?
  campaign    AdCampaign? @relation(fields: [campaignId], references: [id], onDelete: SetNull)
  createdAt   DateTime    @default(now())

  items       SaleItem[]
  warranties  Warranty[]
  payment     Payment?

  @@index([clientId])
  @@index([campaignId])
}

model SaleItem {
  id         String  @id @default(cuid())
  saleId     String
  sale       Sale    @relation(fields: [saleId], references: [id], onDelete: Cascade)
  productId  String
  product    Product @relation(fields: [productId], references: [id], onDelete: Restrict)
  quantity   Int
  unitPrice  Decimal @db.Decimal(12, 2)
  subtotal   Decimal @db.Decimal(12, 2)

  // Costo real (landed) al momento de la venta, para calcular la ganancia real.
  unitCostSnapshot Decimal? @db.Decimal(12, 2)
  costTotal        Decimal? @db.Decimal(12, 2) // = unitCostSnapshot * quantity

  // Unidad serializada vendida en esta línea (productos serializados: 1 línea = 1 unidad).
  unit       Equipment?

  @@index([saleId])
  @@index([productId])
}

// =================== GARANTÍAS ===================

enum WarrantyStatus {
  VIGENTE
  VENCIDA
  RECLAMADA
  ANULADA
}

model Warranty {
  id         String   @id @default(cuid())
  clientId   String
  client     Client   @relation(fields: [clientId], references: [id], onDelete: Cascade)
  productId  String
  product    Product  @relation(fields: [productId], references: [id], onDelete: Restrict)
  saleId     String?
  sale       Sale?    @relation(fields: [saleId], references: [id], onDelete: SetNull)

  serialNumber String?
  startsAt   DateTime @default(now())
  endsAt     DateTime
  status     WarrantyStatus @default(VIGENTE)
  claimNotes String?

  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([clientId])
  @@index([productId])
  @@index([status])
}

// =================== NOTIFICACIONES ===================

enum NotificationChannelType {
  WHATSAPP
  TELEGRAM
  INSTAGRAM
  EMAIL
  SMS
}

enum NotificationStatus {
  PENDIENTE
  ENVIADO
  FALLIDO
}

model NotificationChannel {
  id          String   @id @default(cuid())
  type        NotificationChannelType @unique
  enabled     Boolean  @default(false)
  config      Json?    // credenciales/parámetros específicos
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model NotificationTemplate {
  id          String   @id @default(cuid())
  code        String   @unique   // p.ej. "PAYMENT_REMINDER", "STOCK_DEFICIT", "NEW_USER_PASSWORD"
  name        String
  subject     String?              // para email/push
  body        String               // cuerpo con placeholders {{variable}}
  channelType NotificationChannelType?

  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  logs        NotificationLog[]
}

model NotificationLog {
  id          String   @id @default(cuid())
  templateId  String?
  template    NotificationTemplate? @relation(fields: [templateId], references: [id], onDelete: SetNull)

  channel     NotificationChannelType
  recipient   String               // email, phone, username, chatId, etc.
  subject     String?
  body        String
  status      NotificationStatus   @default(PENDIENTE)
  providerId  String?              // id retornado por el proveedor
  error       String?

  relatedType String?              // "Payment" | "Subscription" | "Warranty" | "Inventory" | "User"
  relatedId   String?

  createdAt   DateTime @default(now())
  sentAt      DateTime?

  @@index([channel, status])
  @@index([recipient])
  @@index([relatedType, relatedId])
}

// =================== EQUIPOS / ANTENAS (unidades serializadas) ===================
// Un Equipment es una UNIDAD serializada de un Producto serializado. Se crea al
// registrar un lote de compra (PurchaseLot) con su costo real (landedCost) y se
// consume al venderse, permitiendo calcular la ganancia real de esa unidad.
// Las filas legacy (sin productId) siguen siendo válidas.

enum EquipmentCondition {
  NUEVO
  USADO
  DANADO
  DADO_DE_BAJA
}

// Disponibilidad comercial (separada del estado físico `condition`).
enum UnitAvailability {
  DISPONIBLE   // en stock, vendible
  RESERVADO
  VENDIDO
  DEVUELTO
  BAJA         // dado de baja / merma
}

model Equipment {
  id            String             @id @default(cuid())
  serialNumber  String?            @unique
  model         String             // "Starlink Gen 3", "Starlink Mini", "Starlink RV", etc.
  condition     EquipmentCondition @default(NUEVO)

  // Vínculo al catálogo y al lote de compra (nullable para filas legacy)
  productId     String?
  product       Product?           @relation(fields: [productId], references: [id], onDelete: Restrict)
  lotId         String?
  lot           PurchaseLot?       @relation(fields: [lotId], references: [id], onDelete: SetNull)
  landedCost    Decimal?           @db.Decimal(12, 2) // costo real de ESTA unidad (de su lote)

  // Disponibilidad comercial
  availability  UnitAvailability   @default(DISPONIBLE)

  // Venta que consumió esta unidad
  saleItemId    String?            @unique
  saleItem      SaleItem?          @relation(fields: [saleItemId], references: [id], onDelete: SetNull)

  clientId      String?
  client        Client?            @relation(fields: [clientId], references: [id], onDelete: SetNull)
  purchaseDate  DateTime?
  purchasePrice Decimal?           @db.Decimal(12, 2) // costo de adquisición legacy (landedCost lo supersede)
  notes         String?
  active        Boolean            @default(true)
  createdAt     DateTime           @default(now())
  updatedAt     DateTime           @updatedAt

  @@index([clientId])
  @@index([serialNumber])
  @@index([condition])
  @@index([productId, availability])
}

// =================== SOPORTE / TICKETS ===================

enum TicketStatus {
  ABIERTO
  EN_PROCESO
  RESUELTO
  CERRADO
}

enum TicketType {
  TECNICO
  FACTURACION
  CONSULTA
  OTRO
}

enum TicketPriority {
  BAJA
  MEDIA
  ALTA
  URGENTE
}

model SupportTicket {
  id          String         @id @default(cuid())
  clientId    String
  client      Client         @relation(fields: [clientId], references: [id], onDelete: Cascade)
  type        TicketType     @default(TECNICO)
  status      TicketStatus   @default(ABIERTO)
  priority    TicketPriority @default(MEDIA)
  title       String
  description String
  resolution  String?
  assignedTo  String?        // userId del admin asignado
  resolvedAt  DateTime?
  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @updatedAt

  @@index([clientId, status])
  @@index([status, priority])
  @@index([assignedTo])
}

// =================== NOTAS DE CLIENTE (Timeline CRM) ===================

model ClientNote {
  id        String   @id @default(cuid())
  clientId  String
  client    Client   @relation(fields: [clientId], references: [id], onDelete: Cascade, name: "clientNotes")
  content   String
  authorId  String?  // userId del admin que escribió la nota
  createdAt DateTime @default(now())

  @@index([clientId, createdAt])
}

// =================== AUDITORÍA ===================

model AuditLog {
  id         String   @id @default(cuid())
  userId     String?
  user       User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
  action     String   // "CREATE" | "UPDATE" | "DELETE" | "LOGIN" | ...
  entity     String   // nombre del modelo
  entityId   String?
  diff       Json?
  ipAddress  String?
  userAgent  String?
  createdAt  DateTime @default(now())

  @@index([userId, createdAt])
  @@index([entity, entityId])
}
